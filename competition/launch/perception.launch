<launch>
  <!-- 仅启动感知节点，供网页控制台按正式/标定模式切换。 -->
  <arg name="calibration_mode" default="false"/>
  <!-- terminal 保留旧命令行交互；网页控制台显式传 web。 -->
  <arg name="interaction_mode" default="terminal"/>
  <arg name="debug_output_dir" default="/home/zhl/桌面"/>
  <arg name="servo_csv_output_dir" default="/home/zhl/桌面/标定数据"/>
  <arg name="experiment_archive_root" default="$(arg servo_csv_output_dir)/实验日志"/>
  <arg name="experiment_session_id" default="$(anon visual_servo_experiment)"/>
  <arg name="block_pixel_to_tcp_calibration_path"
       default="$(find image_process)/config/block_pixel_to_tcp_calibration.yaml"/>
  <arg name="tray_pixel_to_tcp_calibration_path"
       default="$(find image_process)/config/tray_pixel_to_tcp_calibration.yaml"/>

  <node pkg="image_process" type="process.py" name="image_process_node" output="screen">
    <param name="calibration_mode" value="$(arg calibration_mode)"/>
    <param name="interaction_mode" value="$(arg interaction_mode)"/>
    <param name="image_topic" value="/camera/image_rect"/>
    <param name="experiment_session_id" value="$(arg experiment_session_id)"/>
    <param name="experiment_archive_root" value="$(arg experiment_archive_root)"/>
    <param name="block_pixel_to_tcp_calibration_path"
           value="$(arg block_pixel_to_tcp_calibration_path)"/>
    <param name="tray_pixel_to_tcp_calibration_path"
           value="$(arg tray_pixel_to_tcp_calibration_path)"/>
    <param name="advanced_library_path"
           value="$(find image_process)/../jinjie/IDBSA.so"/>
    <param name="save_top_surface_mask_vis" value="true"/>
    <param name="top_surface_mask_vis_path" value="$(arg debug_output_dir)/方块上表面掩码.jpg"/>
    <param name="high_template_match_debug_path" value="$(arg debug_output_dir)/高位方块模板匹配结果.jpg"/>
    <param name="visual_board_grid_debug_path" value="$(arg debug_output_dir)/托盘格点粗定位.jpg"/>
  </node>
</launch>
