<launch>
  <arg name="debug_output_dir" default="/home/zhl/桌面"/>
  <arg name="servo_csv_output_dir" default="/home/zhl/桌面/标定数据"/>
  <arg name="experiment_archive_root" default="$(arg servo_csv_output_dir)/实验日志"/>
  <arg name="experiment_session_id" default="$(anon visual_servo_experiment)"/>

  <node pkg="camera" type="camera_node.py" name="camera_node" output="screen"/>

  <node pkg="image_process" type="process.py" name="image_process_node" output="screen">
    <param name="calibration_mode" value="true"/>
    <param name="experiment_session_id" value="$(arg experiment_session_id)"/>
    <param name="experiment_archive_root" value="$(arg experiment_archive_root)"/>
    <param name="save_top_surface_mask_vis" value="true"/>
    <param name="top_surface_mask_vis_path" value="$(arg debug_output_dir)/方块上表面掩码.jpg"/>
    <param name="high_template_match_debug_path" value="$(arg debug_output_dir)/高位方块模板匹配结果.jpg"/>
    <param name="visual_board_grid_debug_path" value="$(arg debug_output_dir)/托盘格点粗定位.jpg"/>
  </node>

  <node pkg="control" type="controller.py" name="control_node" output="screen">
    <rosparam command="load" file="$(find control)/config/controller.yaml"/>
    <param name="servo_port" value="/dev/servo_motor"/>
    <param name="servo_baudrate" value="115200"/>
    <param name="minimum_z" value="165.0"/>
  </node>

  <node pkg="competition" type="calibration.py" name="calibration_node" output="screen">
    <param name="experiment_session_id" value="$(arg experiment_session_id)"/>
    <param name="servo_csv_output_dir" value="$(arg servo_csv_output_dir)"/>
  </node>
</launch>
